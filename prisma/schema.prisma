// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  // url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL") // Tambahkan ini
}

model Users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   @db.VarChar(255)
  role      Role   @default(USER)
  createdAt DateTime @default(now())

  profiles Profiles?
  borrowings Borrowings[] // tambahkan relasi borrowings
  reviews Review[]
}

enum Role {
  USER
  ADMIN
}

model Books {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  year      Int
  stock     Int  @default(1)
  //tambahkan ini di bawah.
  cloudinaryId String? 
  createdAt DateTime @default(now())
  categoryId Int?

  categories Categories? @relation(fields: [categoryId], references: [id])
  borrowings Borrowings[] // tambahkan relasi borrowings
  reviews Review[] // relasi ke tabel Review
}

model Review {
  id      Int       @id @default(autoincrement())
  rating  Int       //validasi akan di tangani oleh express berkisar antara 1-5
  comment String
  userId  Int
  bookId  Int
  createdAt DateTime @default(now())

  // Relasi di Tabel ini
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Books @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Profiles {
  id      Int       @id @default(autoincrement())
  userId  Int       @unique
  address String?
  phone   String?
  createdAt DateTime  @default(now())

  user Users @relation(fields: [userId], references: [id])
}

model Categories {
  id      Int       @id @default(autoincrement())
  name    String
  createAt DateTime @default(now())

  books Books[]
}

// Pivot Table for Many-to-Many relationship between Users and Books
model Borrowings {
  id          Int       @id @default(autoincrement())
  userId      Int
  bookId      Int
  borrow_date DateTime  @default(now())
  returned_at DateTime?
  createdAt   DateTime  @default(now())
  borrower    Users     @relation(fields: [userId], references: [id])
  book        Books     @relation(fields: [bookId], references: [id])
}